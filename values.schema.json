{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "pollers", "secrets", "service", "serviceMonitor"],
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1},
        "digest": {
          "type": "string",
          "anyOf": [
            {"const": ""},
            {"pattern": "^sha256:[a-fA-F0-9]{64}$"}
          ]
        },
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253,
            "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
          }
        }
      }
    },
    "nameOverride": {
      "type": "string",
      "maxLength": 63,
      "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "fullnameOverride": {
      "type": "string",
      "maxLength": 63,
      "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "pollers": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
        "maxLength": 63
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["datacenter", "addr", "auth"],
        "properties": {
          "datacenter": {"type": "string", "minLength": 1},
          "addr": {"type": "string", "minLength": 1},
          "auth": {
            "type": "object",
            "additionalProperties": false,
            "required": ["username", "existingSecret", "passwordKey"],
            "properties": {
              "username": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[A-Za-z0-9_.@-]+$"
              },
              "existingSecret": {
                "type": "string",
                "minLength": 1,
                "maxLength": 253,
                "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
              },
              "passwordKey": {
                "type": "string",
                "minLength": 1,
                "maxLength": 253,
                "pattern": "^[A-Za-z0-9._-]+$"
              },
              "password": {"type": "string"}
            }
          }
        }
      }
    },
    "harvest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["collectors", "exporter", "credentialsScript", "autosupportDisabled"],
      "properties": {
        "collectors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["Zapi", "ZapiPerf", "Rest", "RestPerf", "KeyPerf", "Ems"]
          }
        },
        "exporter": {
          "type": "object",
          "additionalProperties": false,
          "required": ["addMetaTags", "sortLabels", "cacheMaxKeep"],
          "properties": {
            "addMetaTags": {"type": "boolean"},
            "sortLabels": {"type": "boolean"},
            "cacheMaxKeep": {"type": "string", "pattern": "^[0-9]+(ms|s|m|h)$"}
          }
        },
        "credentialsScript": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schedule", "timeout"],
          "properties": {
            "schedule": {"type": "string", "pattern": "^(always|[0-9]+(ms|s|m|h))$"},
            "timeout": {"type": "string", "pattern": "^[0-9]+(ms|s|m|h)$"}
          }
        },
        "autosupportDisabled": {"type": "boolean"}
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create"],
      "properties": {"create": {"type": "boolean"}}
    },
    "ontapTLS": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verify", "existingCASecret", "caKey", "minVersion"],
      "properties": {
        "verify": {"type": "boolean"},
        "existingCASecret": {
          "type": "string",
          "maxLength": 253,
          "anyOf": [
            {"const": ""},
            {"pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"}
          ]
        },
        "caKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "minVersion": {"type": "string", "enum": ["", "tls10", "tls11", "tls12", "tls13"]}
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "port", "annotations"],
      "properties": {
        "type": {"type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"]},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "annotations": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "serviceMonitor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "interval", "scrapeTimeout", "labels", "annotations"],
      "properties": {
        "enabled": {"type": "boolean"},
        "interval": {"type": "string", "pattern": "^[0-9]+(ms|s|m|h)$"},
        "scrapeTimeout": {"type": "string", "pattern": "^[0-9]+(ms|s|m|h)$"},
        "labels": {"type": "object", "additionalProperties": {"type": "string"}},
        "annotations": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "rollout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["restartToken", "strategy"],
      "properties": {
        "restartToken": {"type": "string"},
        "strategy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {"type": {"type": "string", "enum": ["Recreate", "RollingUpdate"]}}
        }
      }
    },
    "podAnnotations": {"type": "object", "additionalProperties": {"type": "string"}},
    "podLabels": {"type": "object", "additionalProperties": {"type": "string"}},
    "podSecurityContext": {"$ref": "#/definitions/podSecurityContext"},
    "securityContext": {"$ref": "#/definitions/securityContext"},
    "resources": {"$ref": "#/definitions/resources"},
    "startupProbe": {"$ref": "#/definitions/probe"},
    "readinessProbe": {"$ref": "#/definitions/probe"},
    "livenessProbe": {"$ref": "#/definitions/probe"},
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": {"type": "string"},
          "operator": {"type": "string", "enum": ["Exists", "Equal"]},
          "value": {"type": "string"},
          "effect": {"type": "string", "enum": ["", "NoSchedule", "PreferNoSchedule", "NoExecute"]},
          "tolerationSeconds": {"type": "integer", "minimum": 0}
        }
      }
    },
    "affinity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nodeAffinity": {"type": "object"},
        "podAffinity": {"type": "object"},
        "podAntiAffinity": {"type": "object"}
      }
    },
    "priorityClassName": {"type": "string"},
    "terminationGracePeriodSeconds": {"type": "integer", "minimum": 0}
  },
  "definitions": {
    "quantity": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {"type": "number", "minimum": 0}
      ]
    },
    "resourceList": {
      "type": "object",
      "additionalProperties": {"$ref": "#/definitions/quantity"}
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "limits": {"$ref": "#/definitions/resourceList"},
        "requests": {"$ref": "#/definitions/resourceList"},
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "request": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "seccompProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"type": "string", "enum": ["RuntimeDefault", "Localhost", "Unconfined"]},
        "localhostProfile": {"type": "string"}
      }
    },
    "podSecurityContext": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "runAsNonRoot": {"type": "boolean"},
        "runAsUser": {"type": "integer", "minimum": 0},
        "runAsGroup": {"type": "integer", "minimum": 0},
        "fsGroup": {"type": "integer", "minimum": 0},
        "fsGroupChangePolicy": {"type": "string", "enum": ["Always", "OnRootMismatch"]},
        "supplementalGroups": {
          "type": "array",
          "items": {"type": "integer", "minimum": 0}
        },
        "seccompProfile": {"$ref": "#/definitions/seccompProfile"}
      }
    },
    "securityContext": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "allowPrivilegeEscalation": {"type": "boolean"},
        "privileged": {"type": "boolean"},
        "readOnlyRootFilesystem": {"type": "boolean"},
        "runAsNonRoot": {"type": "boolean"},
        "runAsUser": {"type": "integer", "minimum": 0},
        "runAsGroup": {"type": "integer", "minimum": 0},
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "add": {"type": "array", "items": {"type": "string"}},
            "drop": {"type": "array", "items": {"type": "string"}}
          }
        },
        "seccompProfile": {"$ref": "#/definitions/seccompProfile"}
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "failureThreshold", "periodSeconds", "timeoutSeconds"],
      "properties": {
        "enabled": {"type": "boolean"},
        "failureThreshold": {"type": "integer", "minimum": 1},
        "periodSeconds": {"type": "integer", "minimum": 1},
        "timeoutSeconds": {"type": "integer", "minimum": 1}
      }
    }
  }
}
